page{background:#f4f6f3;color:#243c32;font-size:30rpx} .wrap{padding:32rpx 28rpx 70rpx}.hero{padding:32rpx;background:#176b5b;color:white;border-radius:24rpx;margin-bottom:28rpx}.title{font-size:40rpx;font-weight:700;margin-bottom:14rpx}.subtitle,.muted{font-size:26rpx;line-height:1.7;color:#63766b}.hero .subtitle{color:#d7eee5}.card{background:white;padding:28rpx;border-radius:20rpx;margin:20rpx 0;border:1rpx solid #e3e9e4}.name{font-size:32rpx;font-weight:600;line-height:1.5}.tag{display:inline-block;font-size:24rpx;color:#176b5b;background:#e5f2eb;padding:6rpx 14rpx;border-radius:10rpx;margin:10rpx 10rpx 10rpx 0}.row{display:flex;gap:16rpx;flex-wrap:wrap;margin:18rpx 0}.chip{background:#fff;border:1rpx solid #d2ded5;border-radius:30rpx;padding:12rpx 22rpx;font-size:26rpx}.active{background:#176b5b;color:white}input,textarea,.picker{box-sizing:border-box;background:white;border:1rpx solid #cbd8cd;border-radius:14rpx;padding:22rpx;width:100%;margin:14rpx 0}textarea{height:360rpx;line-height:1.7}button{font-size:28rpx;border-radius:14rpx;margin:18rpx 0;background:#e3eee7;color:#176b5b}button.primary{background:#176b5b;color:white}button::after{border:0}.label{display:block;font-weight:600;margin-top:26rpx}.empty{padding:56rpx 20rpx;text-align:center;color:#63766b}.error{color:#a72d2d;background:#fff0eb;padding:24rpx;border-radius:12rpx;margin-bottom:20rpx}.note-preview{white-space:pre-wrap;line-height:1.7;margin-top:18rpx}.small{font-size:24rpx}.backup-text{height:430rpx;font-size:24rpx}.stats{font-size:28rpx;color:#176b5b;font-weight:600;margin:24rpx 0}
/* Explicit input height keeps native input text above the vertical padding. */
input{height:88rpx;min-height:88rpx;padding:0 22rpx;line-height:normal;font-size:30rpx;}
