<view class="wrap">
 <view class="hero"><view class="title">每天留下一点理解</view><view class="subtitle">浏览书籍与纪录片，把阅读变成自己的记录。</view></view>
 <input placeholder="搜索书名、作者或资源" value="{{query}}" bindinput="search" maxlength="100"/>
 <view class="row"><view wx:for="{{kinds}}" wx:key="*this" class="chip {{kind===item?'active':''}}" data-kind="{{item}}" bindtap="filter">{{item}}</view></view>
 <view wx:if="{{error}}" class="error">{{error}}</view>
 <view class="muted">记录仅保存在当前设备，不连接云服务。</view>
 <view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open">
  <view class="tag">{{item.kind}}</view><view wx:if="{{item.record.favorite}}" class="tag">已收藏</view>
  <view class="name">{{item.title}}</view><view class="muted">{{item.author}}</view>
  <view class="small muted">{{item.group}}</view>
  <view wx:if="{{item.record}}" class="muted">{{item.record.status}} · {{item.record.progress}}%</view>
 </view>
 <view wx:if="{{!items.length &amp;&amp; !error}}" class="empty">没有找到匹配资源，换个关键词试试。</view>
</view>